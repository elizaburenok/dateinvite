{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file-if-exists=.env", "packages/api/dist/server.js"],
      "port": 3000
    },
    {
      "name": "guest",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "packages/guest", "run", "dev"],
      "autoPort": true
    },
    {
      "name": "guest-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "packages/guest", "run", "dev:demo"],
      "port": 5180
    },
    {
      "name": "guest-demo-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "packages/guest", "run", "dev:demo:auto"],
      "autoPort": true
    },
    {
      "name": "drum",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),root='packages/guest/prototypes/drum',T={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.jpg':'image/jpeg','.jpeg':'image/jpeg','.png':'image/png','.svg':'image/svg+xml','.woff2':'font/woff2'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const fp=p.join(root,p.normalize(u).replace(/^(\\.\\.[\\/])+/,''));f.readFile(fp,(e,d)=>{if(e){s.writeHead(404,{'Content-Type':'text/plain'});return s.end('404')}s.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream'});s.end(d)})}).listen(5201,()=>console.log('drum stand on http://localhost:5201'))"
      ],
      "port": 5201
    },
    {
      "name": "miniapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "packages/miniapp", "run", "dev"],
      "autoPort": true
    }
  ]
}
