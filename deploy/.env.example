# Скопируйте в корень проекта как .env и заполните.

# --- Обязательное ----------------------------------------------------------

# Токен бота от @BotFather.
BOT_TOKEN=123456789:AA...

# Публичный адрес приложения. Обязательно https — Telegram не принимает
# вебхуки и не открывает Mini App по http. От него строятся ссылки на конверты.
PUBLIC_BASE_URL=https://invite.example.com

# Секрет вебхука: попадает и в путь, и в заголовок X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 24
WEBHOOK_SECRET=

# --- Необязательное (значения по умолчанию) --------------------------------

PORT=3000
HOST=0.0.0.0

# Пути относительно корня проекта.
DB_PATH=data/invite.db
MEDIA_DIR=data/media

# Через сколько дней конверт протухает. 0 — не протухает никогда.
ENVELOPE_TTL_DAYS=14

# Политика Nominatim требует содержательный User-Agent с реальным контактом.
# Без него запросы законно блокируют — подставьте свою почту.
NOMINATIM_USER_AGENT=invite-app/0.1 (you@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
