node_modules/
dist/
*.tsbuildinfo
.DS_Store
.env

# Локальные конфиги тулинга Claude Code (launch.json превью и т.п.). Корневой
# .claude/launch.json уже в гите и там и остаётся — git не выкидывает трекнутые
# файлы; правило гасит только stray-папки .claude/ по пакетам.
.claude/
data/*.db
data/*.db-shm
data/*.db-wal
data/media/*
!data/media/.gitkeep
packages/miniapp/.env.local

# Фото для демо-прототипа — реальные снимки мест, в репозиторий не кладём
packages/guest/public/demo/

# Выгрузки из Figma: исходники обоев и надписей, из которых сделаны ассеты в
# packages/guest/src/assets. Нужное оттуда уже перенесено и лежит в гите; сами
# выгрузки тяжёлые (обои — шесть мегабайт) и импортировать их из пакета всё
# равно нельзя — папка вне packages/guest.
/src/
