{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // grammY тянет типы из DOM/node-fetch; проверять чужие .d.ts нам нечего.
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
