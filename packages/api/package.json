{
  "name": "@invite/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/server.ts",
    "build": "tsc -b && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "tsc -b ../shared && vitest run",
    "smoke:resolver": "npm run build && node --env-file-if-exists=../../.env dist/scripts/smoke-resolver.js",
    "seed:dev": "npm run build && node --env-file-if-exists=../../.env dist/scripts/seed-dev.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.3",
    "@invite/shared": "*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "grammy": "^1.38.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
