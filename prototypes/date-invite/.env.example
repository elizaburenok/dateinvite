# Скопируй этот файл в .env и подставь свои значения.
#
# 1) TELEGRAM_BOT_TOKEN
#    Напиши @BotFather в Telegram → /newbot → придумай имя →
#    он пришлёт токен вида 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 2) TELEGRAM_CHAT_ID
#    Напиши своему новому боту любое сообщение (это важно — иначе бот
#    не сможет тебе писать), затем открой в браузере:
#    https://api.telegram.org/bot<ТВОЙ_ТОКЕН>/getUpdates
#    и найди в ответе "chat":{"id":123456789 — это и есть chat id.
#    Альтернатива: написать @userinfobot, он сразу пришлёт твой id.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
